{
  "kind": "collectionType",
  "collectionName": "pantry_items",
  "info": {
    "singularName": "pantry-item",
    "pluralName": "pantry-items",
    "displayName": "Pantry Item"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "quantity": {
      "type": "decimal",
      "min": 0.01
    },
    "unit": {
      "type": "string",
      "default": "pieces"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Vegetables",
        "Fruits",
        "Dairy",
        "Proteins",
        "Grains",
        "Spices",
        "Other"
      ],
      "default": "Other"
    },
    "emoji": {
      "type": "string"
    },
    "expiryDate": {
      "type": "date"
    },
    "imageUrl": {
      "type": "string"
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "pantry_items"
    }
  }
}